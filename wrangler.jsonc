{
  // Cloudflare Workers deploy: `npm run build` writes ./dist, `npx wrangler
  // deploy` uploads it. Every unknown path falls back to index.html so React
  // Router handles it. Product and lookbook pages go through worker/index.js
  // first, which gives shared links their own preview (title, text, photo);
  // /admin too, for the installable admin app's tags; and robots.txt and
  // sitemap.xml, which the worker writes for the address the site is on.
  "name": "sunday",
  "compatibility_date": "2026-09-23",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every page goes through worker/index.js: share previews, the admin
    // app, short links (/ig…) and the noindex on private pages. Files with
    // nothing to change are served straight from the CDN without running the
    // Worker — the hashed JS and CSS under /assets/, the fonts, the demo and
    // icon pictures — so they don't count against the daily Worker requests.
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/fonts/*",
      "!/demo/*",
      "!/*.png",
      "!/*.jpg",
      "!/*.webp",
      "!/*.svg",
      "!/*.ico",
      "!/*.webmanifest",
      "!/admin-sw.js",
      "!/admin-offline.html",
      "!/og-config.json"
    ]
  }
}
