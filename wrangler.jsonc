{
  // Cloudflare Workers static-assets deploy: `npm run build` writes ./dist,
  // `npx wrangler deploy` uploads it. No server code — every unknown path
  // falls back to index.html so React Router handles it.
  "name": "sunday",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
